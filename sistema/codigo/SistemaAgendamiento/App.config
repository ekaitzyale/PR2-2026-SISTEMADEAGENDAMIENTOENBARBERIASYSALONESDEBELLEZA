<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Cambiar Data Source según la instancia local de SQL Server. -->
    <add name="SistemaAgendamiento"
         connectionString="Data Source=localhost;Initial Catalog=SistemaAgendamiento;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
